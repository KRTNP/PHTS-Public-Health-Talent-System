# Frontend production environment

# Public API base for browser calls (recommended: same-origin to use Next rewrites)
NEXT_PUBLIC_API_URL=/api

# Optional escape hatch: allow direct browser calls to absolute API origin
# (keep disabled unless you intentionally run cross-origin API from browser)
# NEXT_PUBLIC_ALLOW_DIRECT_API_ORIGIN=false

# Backend target for Next.js rewrites
NEXT_INTERNAL_API_PROXY_TARGET=https://your-preview-domain.example

# Optional: allow additional dev origins (comma-separated)
# NEXT_ALLOWED_DEV_ORIGINS=https://your-preview-domain.example
