# =============================================================================
# Core App
# =============================================================================
NODE_ENV=production
PORT=4100

# CORS allow-list
FRONTEND_URL=https://your-frontend.example
# Behind reverse proxy/load balancer: true/1/trusted CIDR
TRUST_PROXY=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=change-me
DB_NAME=phts_system

# Redis (required)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth (required)
JWT_SECRET=replace-with-very-long-random-secret-key-32chars-min
