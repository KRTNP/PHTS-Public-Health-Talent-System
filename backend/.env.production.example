# =============================================================================
# PHTS Backend - Production Environment Template
# =============================================================================

# Core runtime
NODE_ENV=production
PORT=3001

# Public URL allow-list for CORS (comma-separated if multiple frontends)
FRONTEND_URL=https://your-frontend.example
BACKEND_URL=https://your-frontend.example
CORS_PREFLIGHT_ALLOWED_PATHS=/api/auth/login

# Additional auth probe throttling (invalid/expired token spam on /api/auth/me)
AUTH_PROBE_RATE_LIMIT_WINDOW_MS=300000
AUTH_PROBE_RATE_LIMIT_MAX=30

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=phts_system
DB_TIMEZONE=+07:00

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
JWT_SECRET=replace-with-very-long-random-secret-key-32chars-min
JWT_EXPIRES_IN=7d

# OCR baseline (enable only when OCR worker/service is intended in this env)
OCR_ENABLED=false
OCR_PROVIDER=TESSERACT
OCR_SERVICE_URL=local-tesseract
OCR_WORKER_ENABLED=true
