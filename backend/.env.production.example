# =============================================================================
# PHTS Backend - Production Environment Template
# Fill the required values, then enable feature sections only when needed.
# =============================================================================

# Core runtime
NODE_ENV=production
PORT=4100
START_SERVER=true
APP_TIMEZONE=Asia/Bangkok
TZ=Asia/Bangkok

# App identity / base URLs
APP_VERSION=release
APP_COMMIT=unknown
FRONTEND_URL=https://your-frontend.example
BACKEND_URL=https://your-backend.example
TRUST_PROXY=true

# CORS / CSRF / request security
CORS_DEV_TUNNEL_SUFFIXES=.trycloudflare.com
CORS_PREFLIGHT_ALLOWED_PATHS=/api/auth/login
CSRF_TRUSTED_CLIENT_HEADER=x-client-id
# CSRF_TRUSTED_CLIENT_IDS=client-a,client-b

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=change-me
DB_NAME=phts_system
DB_CONNECT_TIMEOUT_MS=10000

# HRMS source databases
HRMS_MAIN_DB=hrms_databases
HRMS_LEAVE_DB=hrms_databases
HRMS_MEETING_DB=hrms_databases

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
JWT_SECRET=replace-with-very-long-random-secret-key-32chars-min
JWT_EXPIRES_IN=24h
AUTH_ALLOW_COOKIE_TOKEN=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
RATE_LIMIT_TRUST_PROXY_HEADERS=true
AUTH_PROBE_RATE_LIMIT_WINDOW_MS=300000
AUTH_PROBE_RATE_LIMIT_MAX=30
SECURITY_RATE_LIMIT_WINDOW_MS=900000
SECURITY_RATE_LIMIT_MAX=300

# Error responses
ERROR_RESPONSE_INCLUDE_DETAILS=false

# Backup
BACKUP_ENABLED=false
BACKUP_COMMAND=C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe
BACKUP_ARGS=["-NoProfile","-ExecutionPolicy","Bypass","-File","src/scripts/ops/backup/backup.ps1"]
BACKUP_WORKDIR=/absolute/path/to/phts-project/backend
BACKUP_TIMEOUT_MS=300000
BACKUP_WORKER_ENABLED=true
BACKUP_WORKER_POLL_MS=60000
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Worker toggles
# Keep these enabled on the single instance that owns background jobs.
SYNC_WORKER_ENABLED=true
SYNC_WORKER_POLL_MS=30000
SNAPSHOT_WORKER_ENABLED=true
SNAPSHOT_WORKER_POLL_MS=10000
SNAPSHOT_WORKER_BATCH_LIMIT=50
NOTIFICATION_OUTBOX_WORKER_ENABLED=true
NOTIFICATION_OUTBOX_WORKER_POLL_MS=10000
NOTIFICATION_OUTBOX_WORKER_BATCH_LIMIT=50
OCR_WORKER_ENABLED=true

# Ops jobs
OPS_JOB_TIMEZONE=Asia/Bangkok

# OCR tuning
# OCR_TESSERACT_LANG=tha+eng
# OCR_TESSERACT_OEM=1
# OCR_TESSERACT_PSM=11
# OCR_TESSERACT_PDF_DPI=200
# OCR_TESSERACT_THREAD_LIMIT=1
# OCR_TESSERACT_PREPROCESS=none

# Optional OCR benchmark runner
# OCR_BENCHMARK_INPUT_DIR=
# OCR_BENCHMARK_OUTPUT_PATH=
