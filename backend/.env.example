# =============================================================================
# PHTS Backend - Minimal Environment Template
# =============================================================================

# Core runtime
NODE_ENV=production
PORT=4100
# Behind reverse proxy/load balancer: true/1/trusted CIDR
TRUST_PROXY=true

# CORS allow-list
FRONTEND_URL=https://your-frontend.example

# Database (required)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=change-me
DB_NAME=phts_system

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Auth / Security / Rate Limit
# =============================================================================
# JWT_SECRET should be >= 32 chars
JWT_SECRET=replace-with-very-long-random-secret-key-32chars-min

# Test overrides (optional)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=your_test_db_user
TEST_DB_PASSWORD=change-me
TEST_DB_NAME=phts_test
