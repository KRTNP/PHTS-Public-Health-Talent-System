# =============================================================================
# PHTS Backend - Minimal Environment Template
# Purpose: required configuration for production + test baseline
# =============================================================================

# Core runtime
NODE_ENV=production
PORT=3001

# CORS allow-list (comma-separated when multiple frontends)
FRONTEND_URL=https://your-frontend.example
BACKEND_URL=https://your-frontend.example
CORS_PREFLIGHT_ALLOWED_PATHS=/api/auth/login:POST
# Optional: set when running behind reverse proxy/load balancer
# Examples: true, false, 1, loopback, 10.0.0.0/8
TRUST_PROXY=

# Additional auth probe throttling (invalid/expired token spam on /api/auth/me)
AUTH_PROBE_RATE_LIMIT_WINDOW_MS=300000
AUTH_PROBE_RATE_LIMIT_MAX=30
# Keep false unless infra guarantees trusted forwarding headers
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Database (required)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=phts_system
DB_TIMEZONE=+07:00

# Test DB overrides (recommended for CI/integration tests)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=change-me
TEST_DB_NAME=phts_test

# Redis (required)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth (required)
JWT_SECRET=replace-with-very-long-random-secret-key-32chars-min
# Cookie auth is enabled by default (HttpOnly token cookie from login).
# Set false only when forcing Authorization-header-only flows.
AUTH_ALLOW_COOKIE_TOKEN=true
# Compatibility mode for legacy clients that still read token from login response body.
AUTH_LOGIN_INCLUDE_TOKEN=false
# Legacy request action aliases (/approve,/reject,/return,/batch-approve).
REQUEST_ENABLE_LEGACY_ACTION_ENDPOINTS=false
# Optional trusted machine-client IDs that may send cookie-auth requests without Origin.
CSRF_TRUSTED_CLIENT_HEADER=x-client-id
CSRF_TRUSTED_CLIENT_IDS=

# OCR baseline (set OCR_ENABLED=true only if you use OCR in this environment)
OCR_ENABLED=false
OCR_PROVIDER=TESSERACT
OCR_SERVICE_URL=local-tesseract
OCR_WORKER_ENABLED=true
