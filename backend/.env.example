# =============================================================================
# PHTS Backend - Base Environment Template
# Use this as the starting point for local development.
# =============================================================================

# Core runtime
NODE_ENV=development
PORT=3001
START_SERVER=true
APP_TIMEZONE=Asia/Bangkok
TZ=Asia/Bangkok

# App URL and proxy
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
TRUST_PROXY=false
CORS_DEV_TUNNEL_SUFFIXES=.trycloudflare.com

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=change-me
DB_NAME=phts_system

# Database test overrides
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_USER=your_test_db_user
# TEST_DB_PASSWORD=change-me
# TEST_DB_NAME=phts_test

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
JWT_SECRET=replace-with-very-long-random-secret-key-32chars-min
JWT_EXPIRES_IN=24h
AUTH_ALLOW_COOKIE_TOKEN=true

# Optional local tuning
# DB_CONNECT_TIMEOUT_MS=5000
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=5
